#!/usr/bin/swift
import Foundation
import ApplicationServices
import CoreGraphics

// Returns true if the Twingate tunnel is active (a utun interface has a 100.x address).
func isConnected() -> Bool {
    let task = Process()
    task.launchPath = "/sbin/ifconfig"
    let pipe = Pipe()
    task.standardOutput = pipe
    task.launch()
    task.waitUntilExit()
    let output = String(data: pipe.fileHandleForReading.readDataToEndOfFile(), encoding: .utf8) ?? ""
    // Twingate allocates addresses in the 100.64.0.0/10 CGNAT range
    return output.components(separatedBy: "\n").contains {
        $0.trimmingCharacters(in: .whitespaces).hasPrefix("inet 100.")
    }
}

let args = CommandLine.arguments.dropFirst()
let command = args.first ?? "toggle"

if command == "status" {
    print(isConnected() ? "on" : "off")
    exit(0)
}

if command == "--on" || command == "--off" {
    let want = command == "--on"
    if isConnected() == want {
        print(want ? "on" : "off")
        exit(0)
    }
    // fall through to toggle logic below
}

if command != "toggle" && command != "--on" && command != "--off" {
    fputs("Usage: twingate [toggle|status|--on|--off]\n", stderr)
    exit(1)
}

// --- toggle ---

let pidTask = Process()
pidTask.launchPath = "/bin/sh"
pidTask.arguments = ["-c", "pgrep -x Twingate"]
let pidPipe = Pipe()
pidTask.standardOutput = pidPipe
pidTask.launch()
pidTask.waitUntilExit()

let pidStr = String(data: pidPipe.fileHandleForReading.readDataToEndOfFile(), encoding: .utf8)!
    .trimmingCharacters(in: .whitespacesAndNewlines)
guard let pid = pid_t(pidStr) else {
    fputs("Twingate is not running\n", stderr)
    exit(1)
}

let savedMousePos = CGEvent(source: nil)?.location ?? .zero

func click(at pt: CGPoint) {
    let down = CGEvent(mouseEventSource: nil, mouseType: .leftMouseDown, mouseCursorPosition: pt, mouseButton: .left)!
    let up   = CGEvent(mouseEventSource: nil, mouseType: .leftMouseUp,   mouseCursorPosition: pt, mouseButton: .left)!
    down.post(tap: .cghidEventTap)
    Thread.sleep(forTimeInterval: 0.05)
    up.post(tap: .cghidEventTap)
}

func children(_ elem: AXUIElement) -> [AXUIElement] {
    var val: CFTypeRef?
    AXUIElementCopyAttributeValue(elem, kAXChildrenAttribute as CFString, &val)
    return (val as? [AXUIElement]) ?? []
}

func role(_ elem: AXUIElement) -> String {
    var val: CFTypeRef?
    AXUIElementCopyAttributeValue(elem, kAXRoleAttribute as CFString, &val)
    return (val as? String) ?? ""
}

func frame(_ elem: AXUIElement) -> CGRect {
    var posVal: CFTypeRef?
    var sizeVal: CFTypeRef?
    AXUIElementCopyAttributeValue(elem, kAXPositionAttribute as CFString, &posVal)
    AXUIElementCopyAttributeValue(elem, kAXSizeAttribute as CFString, &sizeVal)
    var pos = CGPoint.zero; var size = CGSize.zero
    if let pv = posVal { AXValueGetValue(pv as! AXValue, .cgPoint, &pos) }
    if let sv = sizeVal { AXValueGetValue(sv as! AXValue, .cgSize, &size) }
    return CGRect(origin: pos, size: size)
}

func findFirst(role targetRole: String, minWidth: CGFloat = 0, in elem: AXUIElement) -> AXUIElement? {
    if role(elem) == targetRole && frame(elem).width >= minWidth { return elem }
    for child in children(elem) {
        if let found = findFirst(role: targetRole, minWidth: minWidth, in: child) { return found }
    }
    return nil
}

let app = AXUIElementCreateApplication(pid)
let menuBars = children(app).filter { role($0) == "AXMenuBar" }

guard menuBars.count > 1 else {
    fputs("Could not find Twingate status bar\n", stderr)
    exit(1)
}

guard let statusItem = children(menuBars[1]).first else {
    fputs("No status item found\n", stderr)
    exit(1)
}

let wasConnected = isConnected()

let iconFrame = frame(statusItem)
click(at: CGPoint(x: iconFrame.midX, y: iconFrame.midY))
Thread.sleep(forTimeInterval: 0.8)

guard let toggle = findFirst(role: "AXUnknown", minWidth: 30, in: statusItem) else {
    fputs("Could not find toggle - menu may not have opened\n", stderr)
    CGWarpMouseCursorPosition(savedMousePos)
    exit(1)
}

let toggleFrame = frame(toggle)
click(at: CGPoint(x: toggleFrame.midX, y: toggleFrame.midY))

CGWarpMouseCursorPosition(savedMousePos)

print(wasConnected ? "off" : "on")
